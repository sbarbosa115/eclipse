{
    "openapi": "3.0.0",
    "info": {
        "title": "Mustang API",
        "description": "The JSON API behind the React UI.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/auth/sign-up": {
            "post": {
                "summary": "Creates a company and its owner, and signs the owner in.",
                "operationId": "post_app_access_ui_http_auth_signup",
                "responses": {
                    "201": {
                        "description": "Created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/me": {
            "get": {
                "summary": "Who is signed in.",
                "operationId": "get_app_access_ui_http_auth_me",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/posting-rules": {
            "get": {
                "summary": "Every concept with the account it posts to, in the order of \u00a75.",
                "operationId": "get_app_ledger_ui_http_booksettings_postingrules",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/PostingRuleOutput"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/posting-rules/{concept}": {
            "put": {
                "summary": "Points a concept at another account: {account_id}. The account must be postable (409 account_not_postable) and\nwithin the concept's part of the PUC (422 account_not_allowed_for_concept). 404 for an unknown concept or\nanother company's account.",
                "operationId": "put_app_ledger_ui_http_booksettings_changepostingrule",
                "parameters": [
                    {
                        "name": "concept",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PostingRuleOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/ledger/lock-date": {
            "get": {
                "summary": "The fecha de bloqueo contable: nothing is emitted or voided on or before it.",
                "operationId": "get_app_ledger_ui_http_booksettings_lockdate",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LockDateOutput"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Moves the fecha de bloqueo: {locked_until: YYYY-MM-DD}, today at the latest (422 lock_date_in_future).",
                "operationId": "put_app_ledger_ui_http_booksettings_movelockdate",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LockDateOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/taxes": {
            "get": {
                "summary": "The company's taxes. ?class=charge|withholding; ?all=1 includes the inactive ones.",
                "operationId": "get_app_ledger_ui_http_catalog_taxes",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/TaxOutput"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/payment-methods": {
            "get": {
                "summary": "The company's payment methods. ?all=1 includes the inactive ones.",
                "operationId": "get_app_ledger_ui_http_catalog_paymentmethods",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/PaymentMethodOutput"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/accounts/search": {
            "get": {
                "summary": "Postable accounts for a picker: ?q= matches a code prefix or part of the name; ?purchases=1 only those usable on\npurchase lines. At most 20.",
                "operationId": "get_app_ledger_ui_http_catalog_searchaccounts",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/AccountOutput"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/accounts": {
            "get": {
                "summary": "The chart in code order: ?q= (digits: a code prefix; words: part of the name), ?class=1\u20269, ?page, ?per_page \u2264 100\n(default 50).",
                "operationId": "get_app_ledger_ui_http_chart_list",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items",
                                        "total",
                                        "page",
                                        "per_page"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/AccountOutput"
                                            }
                                        },
                                        "total": {
                                            "type": "integer"
                                        },
                                        "page": {
                                            "type": "integer"
                                        },
                                        "per_page": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Adds a sub-account or auxiliar: {parent_code, code (the parent's plus two digits), name, usable_on_purchases?}.",
                "description": "409 account_code_taken; 422 account_code_invalid, parent_account_not_found; 403 for the billing user.",
                "operationId": "post_app_ledger_ui_http_chart_add",
                "responses": {
                    "201": {
                        "description": "Created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AccountOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/accounts/{id}": {
            "put": {
                "summary": "{name, active, usable_on_purchases}. A PUC account keeps its name (409 account_standard); an account a posting\nrule uses stays active (409 account_in_posting_rule); another company's id is 404.",
                "operationId": "put_app_ledger_ui_http_chart_update",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AccountOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/ledger/journal": {
            "get": {
                "summary": "Entries by date and number, each with all its lines: ?from, ?to, ?account (a code: that account and its\nchildren), ?tercero_id, ?page, ?per_page \u2264 100 (default 25).",
                "operationId": "get_app_ledger_ui_http_ledgerreport_journal",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items",
                                        "total",
                                        "page",
                                        "per_page"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/JournalEntryOutput"
                                            }
                                        },
                                        "total": {
                                            "type": "integer"
                                        },
                                        "page": {
                                            "type": "integer"
                                        },
                                        "per_page": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/ledger/trial-balance": {
            "get": {
                "summary": "Per account and its parents: saldo anterior, d\u00e9bitos, cr\u00e9ditos and nuevo saldo for ?from\u2013?to.",
                "operationId": "get_app_ledger_ui_http_ledgerreport_trialbalance",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TrialBalanceOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/ledger/income-statement": {
            "get": {
                "summary": "Ingresos, costos and gastos of ?from\u2013?to, and the period's result.",
                "operationId": "get_app_ledger_ui_http_ledgerreport_incomestatement",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/IncomeStatementOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/ledger/balance-sheet": {
            "get": {
                "summary": "Activo, pasivo and patrimonio at ?date (default today).",
                "operationId": "get_app_ledger_ui_http_ledgerreport_balancesheet",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BalanceSheetOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros": {
            "get": {
                "summary": "Search: ?q= (part of the name or identification, at least 3 characters on documents), ?role=cliente|proveedor|\nempleado|otro, ?active=1, ?page, ?per_page \u2264 100.",
                "operationId": "get_app_party_ui_http_tercero_list",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items",
                                        "total",
                                        "page",
                                        "per_page"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/TerceroSummaryOutput"
                                            }
                                        },
                                        "total": {
                                            "type": "integer"
                                        },
                                        "page": {
                                            "type": "integer"
                                        },
                                        "per_page": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros/quick": {
            "post": {
                "summary": "Quick-create from inside a document (\u00a74.2): {person_type, identification_type, identification_number,\ncheck_digit?, first_names?, last_names?, business_name?, email?, roles: [cliente|proveedor|\u2026]} \u2192 201.",
                "operationId": "post_app_party_ui_http_tercero_quickcreate",
                "responses": {
                    "201": {
                        "description": "Created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TerceroSummaryOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros/{id}/contacts": {
            "get": {
                "summary": "A tercero's contacts, for the document header's Contacto.",
                "operationId": "get_app_party_ui_http_tercero_contacts",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ContactOutput"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products": {
            "get": {
                "summary": "Search: ?q= (part of the code or name), ?type=producto|servicio, ?active=1, ?page, ?per_page \u2264 100.",
                "operationId": "get_app_catalog_ui_http_product_list",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items",
                                        "total",
                                        "page",
                                        "per_page"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ProductOutput"
                                            }
                                        },
                                        "total": {
                                            "type": "integer"
                                        },
                                        "page": {
                                            "type": "integer"
                                        },
                                        "per_page": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products/quick": {
            "post": {
                "summary": "Quick-create from a document line (\u00a74.3): {type, code, name, sale_price, price_includes_tax, charge_tax_id?,\nwithholding_tax_id?} \u2192 201.",
                "operationId": "post_app_catalog_ui_http_product_quickcreate",
                "responses": {
                    "201": {
                        "description": "Created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products/{id}/taxes": {
            "put": {
                "summary": "Writes \"use these taxes on this product from now on\" (\u00a74.6 line tax dialog): {charge_tax_id, withholding_tax_id}.",
                "operationId": "put_app_catalog_ui_http_product_settaxes",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductOutput"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "SessionOutput": {
                "required": [
                    "user_id",
                    "email",
                    "name",
                    "role",
                    "company_id",
                    "company_name",
                    "company_nit"
                ],
                "properties": {
                    "user_id": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "role": {
                        "title": "owner, billing or accountant",
                        "type": "string"
                    },
                    "company_id": {
                        "type": "string"
                    },
                    "company_name": {
                        "type": "string"
                    },
                    "company_nit": {
                        "type": "string"
                    },
                    "company_check_digit": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PostingRuleOutput": {
                "required": [
                    "concept",
                    "account_id",
                    "account_code",
                    "account_name",
                    "allowed_prefixes"
                ],
                "properties": {
                    "concept": {
                        "title": "ingreso, descuento_ventas, iva_generado\u2026 (PostingConcept)",
                        "type": "string"
                    },
                    "account_id": {
                        "type": "string"
                    },
                    "account_code": {
                        "type": "string"
                    },
                    "account_name": {
                        "type": "string"
                    },
                    "allowed_prefixes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "type": "object"
            },
            "LockDateOutput": {
                "properties": {
                    "locked_until": {
                        "title": "YYYY-MM-DD, or null while the books are open.",
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "TaxOutput": {
                "required": [
                    "id",
                    "name",
                    "tax_class",
                    "kind",
                    "calculation",
                    "rate",
                    "active",
                    "standard"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "tax_class": {
                        "title": "charge (impuesto cargo) or withholding (retenci\u00f3n)",
                        "type": "string"
                    },
                    "kind": {
                        "title": "none, iva, impoconsumo, retefuente, reteiva, reteica",
                        "type": "string"
                    },
                    "calculation": {
                        "title": "percentage or per_unit",
                        "type": "string"
                    },
                    "rate": {
                        "title": "Decimal string: a percentage (\"19.0000\") or a value per unit (\"500.0000\").",
                        "type": "string"
                    },
                    "sales_account_id": {
                        "type": "string",
                        "nullable": true
                    },
                    "purchase_account_id": {
                        "type": "string",
                        "nullable": true
                    },
                    "valid_from": {
                        "type": "string",
                        "nullable": true
                    },
                    "valid_to": {
                        "type": "string",
                        "nullable": true
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "standard": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "PaymentMethodOutput": {
                "required": [
                    "id",
                    "name",
                    "kind",
                    "active",
                    "standard"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "kind": {
                        "title": "cash (contado) or credit (cr\u00e9dito)",
                        "type": "string"
                    },
                    "account_id": {
                        "type": "string",
                        "nullable": true
                    },
                    "account_code": {
                        "type": "string",
                        "nullable": true
                    },
                    "account_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "standard": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "AccountOutput": {
                "required": [
                    "id",
                    "code",
                    "name",
                    "nature",
                    "level",
                    "standard",
                    "active",
                    "postable",
                    "usable_on_purchases"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "nature": {
                        "title": "debit or credit",
                        "type": "string"
                    },
                    "level": {
                        "title": "class, group, account, subaccount, auxiliary",
                        "type": "string"
                    },
                    "parent_code": {
                        "type": "string",
                        "nullable": true
                    },
                    "standard": {
                        "type": "boolean"
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "postable": {
                        "type": "boolean"
                    },
                    "usable_on_purchases": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "JournalLineOutput": {
                "required": [
                    "account_id",
                    "account_code",
                    "account_name",
                    "debit",
                    "credit"
                ],
                "properties": {
                    "account_id": {
                        "type": "string"
                    },
                    "account_code": {
                        "type": "string"
                    },
                    "account_name": {
                        "type": "string"
                    },
                    "tercero_id": {
                        "type": "string",
                        "nullable": true
                    },
                    "tercero_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "debit": {
                        "title": "Decimal string; one of d\u00e9bito and cr\u00e9dito is \"0.00\".",
                        "type": "string"
                    },
                    "credit": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "JournalEntryOutput": {
                "required": [
                    "id",
                    "number",
                    "date",
                    "source_type",
                    "source_id",
                    "source_number",
                    "description",
                    "total_debit",
                    "total_credit",
                    "lines"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "number": {
                        "type": "integer"
                    },
                    "date": {
                        "type": "string"
                    },
                    "source_type": {
                        "title": "sales_invoice, cash_receipt, purchase_invoice, supplier_payment\u2026",
                        "type": "string"
                    },
                    "source_id": {
                        "type": "string"
                    },
                    "source_number": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "reverses_id": {
                        "title": "The entry this one reverses (a void), if any.",
                        "type": "string",
                        "nullable": true
                    },
                    "total_debit": {
                        "type": "string"
                    },
                    "total_credit": {
                        "type": "string"
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/JournalLineOutput"
                        }
                    }
                },
                "type": "object"
            },
            "TrialBalanceRowOutput": {
                "required": [
                    "code",
                    "name",
                    "level",
                    "nature",
                    "opening",
                    "debit",
                    "credit",
                    "closing"
                ],
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "level": {
                        "title": "class, group, account, subaccount, auxiliary",
