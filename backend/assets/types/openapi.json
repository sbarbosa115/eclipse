{
    "openapi": "3.0.0",
    "info": {
        "title": "Mustang API",
        "description": "The JSON API behind the React UI.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/auth/sign-up": {
            "post": {
                "summary": "Creates a company and its owner, and signs the owner in.",
                "operationId": "post_app_access_ui_http_auth_signup",
                "responses": {
                    "201": {
                        "description": "Created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/me": {
            "get": {
                "summary": "Who is signed in.",
                "operationId": "get_app_access_ui_http_auth_me",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/taxes": {
            "get": {
                "summary": "The company's taxes. ?class=charge|withholding; ?all=1 includes the inactive ones.",
                "operationId": "get_app_ledger_ui_http_catalog_taxes",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/TaxOutput"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/payment-methods": {
            "get": {
                "summary": "The company's payment methods. ?all=1 includes the inactive ones.",
                "operationId": "get_app_ledger_ui_http_catalog_paymentmethods",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/PaymentMethodOutput"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/accounts/search": {
            "get": {
                "summary": "Postable accounts for a picker: ?q= matches a code prefix or part of the name; ?purchases=1 only those usable on\npurchase lines. At most 20.",
                "operationId": "get_app_ledger_ui_http_catalog_searchaccounts",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/AccountOutput"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros": {
            "get": {
                "summary": "Search: ?q= (part of the name or identification, at least 3 characters on documents), ?role=cliente|proveedor|\nempleado|otro, ?active=1 (only active) or 0 (only inactive), ?page, ?per_page \u2264 100.",
                "operationId": "get_app_party_ui_http_tercero_list",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items",
                                        "total",
                                        "page",
                                        "per_page"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/TerceroSummaryOutput"
                                            }
                                        },
                                        "total": {
                                            "type": "integer"
                                        },
                                        "page": {
                                            "type": "integer"
                                        },
                                        "per_page": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "The full form: creates the tercero (datos b\u00e1sicos, facturaci\u00f3n y env\u00edo, responsabilidades, contactos, cuentas).",
                "description": "422 `duplicate_identification` (violation on `identification_number`) when tipo + n\u00famero + sucursal exist.",
                "operationId": "post_app_party_ui_http_tercero_create",
                "responses": {
                    "201": {
                        "description": "Created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TerceroOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros/quick": {
            "post": {
                "summary": "Quick-create from inside a document (\u00a74.2): {person_type, identification_type, identification_number,\ncheck_digit?, first_names?, last_names?, business_name?, email, roles: [cliente|proveedor|\u2026]} \u2192 201.",
                "operationId": "post_app_party_ui_http_tercero_quickcreate",
                "responses": {
                    "201": {
                        "description": "Created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TerceroSummaryOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros/{id}/contacts": {
            "get": {
                "summary": "A tercero's contacts, for the document header's Contacto.",
                "operationId": "get_app_party_ui_http_tercero_contacts",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ContactOutput"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros/{id}": {
            "get": {
                "summary": "One tercero with everything on its form.",
                "operationId": "get_app_party_ui_http_tercero_show",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TerceroOutput"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Replaces the tercero's data (the whole form is sent). Contacts with an `id` are kept, the ones left out are\nremoved. 422 `duplicate_identification`; 422 `tercero_erased` once its personal data was erased.",
                "operationId": "put_app_party_ui_http_tercero_update",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TerceroOutput"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "summary": "Deletes a tercero no document references; 409 `tercero_in_use` otherwise (deactivate it instead).",
                "operationId": "delete_app_party_ui_http_tercero_delete",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/terceros/{id}/deactivate": {
            "post": {
                "summary": "Stops offering the tercero on new documents. Existing documents are untouched.",
                "operationId": "post_app_party_ui_http_tercero_deactivate",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TerceroOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros/{id}/reactivate": {
            "post": {
                "operationId": "post_app_party_ui_http_tercero_reactivate",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TerceroOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros/{id}/export": {
            "get": {
                "summary": "Ley 1581 de 2012: the tercero's personal data as JSON (served as a download). Leaves an audit-log entry.",
                "operationId": "get_app_party_ui_http_tercero_export",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TerceroExportOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/terceros/{id}/erase": {
            "post": {
                "summary": "Ley 1581 de 2012: blanks the tercero's personal data and its contacts and deactivates it; the row stays (its\ndocuments name it), with its identification and `erased_at`. Cannot be undone.",
                "operationId": "post_app_party_ui_http_tercero_erase",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TerceroOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products": {
            "get": {
                "summary": "Search: ?q= (part of the code or name), ?type=producto|servicio, ?active=1, ?page, ?per_page \u2264 100.",
                "operationId": "get_app_catalog_ui_http_product_list",
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "items",
                                        "total",
                                        "page",
                                        "per_page"
                                    ],
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ProductOutput"
                                            }
                                        },
                                        "total": {
                                            "type": "integer"
                                        },
                                        "page": {
                                            "type": "integer"
                                        },
                                        "per_page": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products/quick": {
            "post": {
                "summary": "Quick-create from a document line (\u00a74.3): {type, code, name, sale_price, price_includes_tax, charge_tax_id?,\nwithholding_tax_id?} \u2192 201.",
                "operationId": "post_app_catalog_ui_http_product_quickcreate",
                "responses": {
                    "201": {
                        "description": "Created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductOutput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products/{id}/taxes": {
            "put": {
                "summary": "Writes \"use these taxes on this product from now on\" (\u00a74.6 line tax dialog): {charge_tax_id, withholding_tax_id}.",
                "operationId": "put_app_catalog_ui_http_product_settaxes",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductOutput"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "SessionOutput": {
                "required": [
                    "user_id",
                    "email",
                    "name",
                    "role",
                    "company_id",
                    "company_name",
                    "company_nit"
                ],
                "properties": {
                    "user_id": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "role": {
                        "title": "owner, billing or accountant",
                        "type": "string"
                    },
                    "company_id": {
                        "type": "string"
                    },
                    "company_name": {
                        "type": "string"
                    },
                    "company_nit": {
                        "type": "string"
                    },
                    "company_check_digit": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "TaxOutput": {
                "required": [
                    "id",
                    "name",
                    "tax_class",
                    "kind",
                    "calculation",
                    "rate",
                    "active",
                    "standard"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "tax_class": {
                        "title": "charge (impuesto cargo) or withholding (retenci\u00f3n)",
                        "type": "string"
                    },
                    "kind": {
                        "title": "none, iva, impoconsumo, retefuente, reteiva, reteica",
                        "type": "string"
                    },
                    "calculation": {
                        "title": "percentage or per_unit",
                        "type": "string"
                    },
                    "rate": {
                        "title": "Decimal string: a percentage (\"19.0000\") or a value per unit (\"500.0000\").",
                        "type": "string"
                    },
                    "sales_account_id": {
                        "type": "string",
                        "nullable": true
                    },
                    "purchase_account_id": {
                        "type": "string",
                        "nullable": true
                    },
                    "valid_from": {
                        "type": "string",
                        "nullable": true
                    },
                    "valid_to": {
                        "type": "string",
                        "nullable": true
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "standard": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "PaymentMethodOutput": {
                "required": [
                    "id",
                    "name",
                    "kind",
                    "active",
                    "standard"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "kind": {
                        "title": "cash (contado) or credit (cr\u00e9dito)",
                        "type": "string"
                    },
                    "account_id": {
                        "type": "string",
                        "nullable": true
                    },
                    "account_code": {
                        "type": "string",
                        "nullable": true
                    },
                    "account_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "standard": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "AccountOutput": {
                "required": [
                    "id",
                    "code",
                    "name",
                    "nature",
                    "level",
                    "standard",
                    "active",
                    "postable",
                    "usable_on_purchases"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "nature": {
                        "title": "debit or credit",
                        "type": "string"
                    },
                    "level": {
                        "title": "class, group, account, subaccount, auxiliary",
                        "type": "string"
                    },
                    "parent_code": {
                        "type": "string",
                        "nullable": true
                    },
                    "standard": {
                        "type": "boolean"
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "postable": {
                        "type": "boolean"
                    },
                    "usable_on_purchases": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "TerceroSummaryOutput": {
                "required": [
                    "id",
                    "display_name",
                    "person_type",
                    "identification_type",
                    "identification_number",
                    "roles",
                    "active",
                    "branch_code"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "person_type": {
                        "title": "persona or empresa",
                        "type": "string"
                    },
                    "identification_type": {
                        "title": "cc, nit, ce, pasaporte, \u2026",
                        "type": "string"
                    },
                    "identification_number": {
                        "type": "string"
                    },
                    "check_digit": {
                        "type": "string",
                        "nullable": true
                    },
                    "email": {
                        "type": "string",
                        "nullable": true
                    },
                    "city": {
                        "type": "string",
                        "nullable": true
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "branch_code": {
                        "type": "string"
                    },
                    "trade_name": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PhoneOutput": {
                "required": [
                    "indicative",
                    "number"
                ],
                "properties": {
                    "indicative": {
                        "type": "string"
                    },
                    "number": {
                        "type": "string"
                    },
                    "extension": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "AccountRefOutput": {
                "required": [
                    "id",
                    "code",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "ContactOutput": {
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "nullable": true
                    },
                    "phone": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "TerceroOutput": {
                "required": [
                    "id",
                    "display_name",
                    "person_type",
                    "identification_type",
                    "identification_number",
                    "branch_code",
                    "phones",
                    "billing_contact_is_payer",
                    "fiscal_responsibilities",
                    "roles",
                    "contacts",
                    "active",
                    "created_at"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "person_type": {
                        "title": "persona or empresa",
                        "type": "string"
                    },
                    "identification_type": {
                        "title": "cc, nit, ce, pasaporte, \u2026",
                        "type": "string"
                    },
                    "identification_number": {
                        "type": "string"
                    },
                    "check_digit": {
                        "type": "string",
                        "nullable": true
                    },
                    "branch_code": {
                        "type": "string"
                    },
                    "first_names": {
                        "type": "string",
                        "nullable": true
                    },
                    "last_names": {
                        "type": "string",
                        "nullable": true
                    },
                    "business_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "trade_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "city": {
                        "type": "string",
                        "nullable": true
                    },
                    "address": {
                        "type": "string",
                        "nullable": true
                    },
                    "phones": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PhoneOutput"
                        }
                    },
                    "billing_contact_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "email": {
                        "type": "string",
                        "nullable": true
                    },
                    "mobile": {
                        "type": "string",
                        "nullable": true
                    },
                    "postal_code": {
                        "type": "string",
                        "nullable": true
                    },
                    "vat_regime": {
                        "title": "responsable, no_responsable or simple",
                        "type": "string",
                        "nullable": true
                    },
                    "billing_contact_is_payer": {
                        "type": "boolean"
                    },
                    "fiscal_responsibilities": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "receivable_account": {
                        "nullable": true,
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/AccountRefOutput"
                            }
                        ]
                    },
                    "payable_account": {
                        "nullable": true,
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/AccountRefOutput"
                            }
                        ]
                    },
                    "contacts": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ContactOutput"
                        }
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "erased_at": {
                        "title": "ISO 8601 date-time when the personal data was erased on request (Ley 1581), else null",
                        "type": "string",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "TerceroExportOutput": {
                "required": [
                    "exported_at",
                    "tercero"
