{#
    Any report as a table, in the company's frame (reports item). Context: columns [{label, numeric}], rows (lists of
    already printed text), totals (a printed row or null), subtitle (lines under the header); company, logo_data_uri,
    title as the frame needs.
#}
{% extends 'pdf/document.html.twig' %}

{# A wide report (exógena, retenciones) turns the page and shrinks its type so every column fits (IMP-11, EXO-07). #}
{% set wide = columns|length > 6 %}
{% set very_wide = columns|length > 10 %}

{% block page_size %}{% if wide %}size: letter landscape; {% endif %}{% endblock %}

{% block page_style %}
    {% if wide %}
        table.lines { table-layout: auto; }
        table.lines th, table.lines td { font-size: {{ very_wide ? '6pt' : '7.5pt' }}; padding: 3px 2px; }
        table.lines th.num { white-space: normal; }
    {% endif %}
{% endblock %}

{% block body %}
    {% for line in subtitle %}<div class="muted">{{ line }}</div>{% endfor %}
    <table class="lines">
        <thead>
            <tr>
                {% for column in columns %}<th{% if column.numeric %} class="num"{% endif %}>{{ column.label }}</th>{% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    {% for cell in row %}<td{% if columns[loop.index0].numeric %} class="num"{% endif %}>{{ cell }}</td>{% endfor %}
                </tr>
            {% else %}
                <tr><td colspan="{{ columns|length }}" class="muted">Sin datos para este reporte.</td></tr>
            {% endfor %}
            {% if totals %}
                <tr>
                    {% for cell in totals %}<td class="{% if columns[loop.index0].numeric %}num {% endif %}total"><strong>{{ cell }}</strong></td>{% endfor %}
                </tr>
            {% endif %}
        </tbody>
    </table>
{% endblock %}
