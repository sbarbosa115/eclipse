{#
    The frame of every PDF: the company's header (logo, razón social, NIT-DV, address, contact) and the page.
    Context: company (Company\Application\Query\CompanyView as an array or object), logo_data_uri (optional),
    title, number (optional). A document template extends this and fills {% block body %}.
#}
<!doctype html>
<html lang="es-CO">
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 18mm 15mm; }
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 9pt; color: #1f2933; }
        .header { width: 100%; border-bottom: 1px solid #cbd2d9; padding-bottom: 8px; margin-bottom: 12px; }
        .header td { vertical-align: top; }
        .logo { max-height: 60px; max-width: 160px; }
        .company-name { font-size: 12pt; font-weight: bold; }
        .doc-title { text-align: right; font-size: 13pt; font-weight: bold; }
        .doc-number { text-align: right; font-size: 11pt; }
        table.lines { width: 100%; border-collapse: collapse; margin-top: 8px; }
        table.lines th { background: #e4e7eb; text-align: left; padding: 4px; font-size: 8pt; }
        table.lines th.num { text-align: right; }
        table.lines td { border-bottom: 1px solid #e4e7eb; padding: 4px; }
        .num { text-align: right; white-space: nowrap; }
        .muted { color: #616e7c; }
        .voided { position: fixed; top: 40%; left: 10%; font-size: 72pt; color: rgba(200, 30, 30, 0.25); transform: rotate(-30deg); }
    </style>
</head>
<body>
    {% block watermark %}{% endblock %}
    <table class="header">
        <tr>
            <td>
                {% if logo_data_uri is defined and logo_data_uri %}<img class="logo" src="{{ logo_data_uri }}" alt=""><br>{% endif %}
                <span class="company-name">{{ company.legalName }}</span><br>
                {% if company.tradeName %}{{ company.tradeName }}<br>{% endif %}
                NIT {{ company.identificationNumber }}{% if company.checkDigit is not null %}-{{ company.checkDigit }}{% endif %}<br>
                {% if company.address %}{{ company.address }}{% if company.city %}, {{ company.city }}{% endif %}<br>{% endif %}
                {% if company.phone %}Tel. {{ company.phone }} {% endif %}{% if company.email %}· {{ company.email }}{% endif %}
            </td>
            <td>
                <div class="doc-title">{{ title }}</div>
                {% if number is defined and number %}<div class="doc-number">No. {{ number }}</div>{% endif %}
            </td>
        </tr>
    </table>
    {% block body %}{% endblock %}
</body>
</html>
