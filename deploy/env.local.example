# Production settings for a cPanel account. Copy to backend/.env.local, fill in, then: chmod 600 backend/.env.local
# It is never committed (backend/.gitignore ignores .env.local), so a git pull cannot overwrite it.

APP_ENV=prod
APP_DEBUG=0

# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# The database cPanel created. serverVersion MUST match the real server (SELECT VERSION() in phpMyAdmin); MariaDB needs
# the suffix, e.g. serverVersion=10.11.10-MariaDB. deploy/cpanel-update.sh refuses to continue until this matches.
DATABASE_URL="mysql://CPANELUSER_mustang:PASSWORD@127.0.0.1:3306/CPANELUSER_mustang?serverVersion=10.11.10-MariaDB&charset=utf8mb4"

# The public address of the site: links in e-mails are built from it.
APP_URL=https://app.example.co
DEFAULT_URI=https://app.example.co

# Attachments and logos. OUTSIDE the document root (~/eclipse/backend/public).
UPLOADS_DIR=/home/CPANELUSER/mustang-uploads

# Plain SMTP to cPanel's own mail server: connect by the name on its certificate (hostname -f). "@" is %40.
MAILER_DSN=smtp://no-reply%40example.co:PASSWORD@server-XXXXXX.example.com:587
MAILER_FROM=no-reply@example.co

# The Doctrine queue (a table in the app's database), drained by the cron line deploy/cpanel-update.sh prints.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# One server, so a file lock is enough.
LOCK_DSN=flock

# Only behind a proxy/CDN: its IP ranges, comma-separated, so rate limits see each visitor's IP. Empty otherwise.
TRUSTED_PROXIES=
